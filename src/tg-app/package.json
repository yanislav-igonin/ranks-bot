{
  "name": "ranks-telegram-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "volta": {
    "node": "22.21.1",
    "npm": "10.9.4"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.5",
    "@types/node": "22.20.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "10.0.4",
    "jsdom": "^27.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  }
}
