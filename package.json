{
  "name": "ranks-bot",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "nodemon -r dotenv/config --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "test": "node test/reply-in-chunks.test.js",
    "build": "tsc -p .",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "format:check": "biome format src test",
    "check": "biome check src test"
  },
  "author": "Yanislav Igonin <yanislavdabest@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "volta": {
    "node": "22.21.1",
    "npm": "10.9.4"
  },
  "dependencies": {
    "ngrok": "3.4.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "telegraf": "4.16.3",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "husky": "^1.3.1",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "husky": {
    "pre-push": "npm run check"
  }
}
