{
  "name": "ranks-bot",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "nodemon -r dotenv/config --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "test": "node test/reply-in-chunks.test.js",
    "build": "tsc -p .",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "format:check": "biome format src test",
    "check": "biome check src test"
  },
  "author": "Yanislav Igonin <yanislavdabest@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "volta": {
    "node": "22.21.1",
    "npm": "10.9.4"
  },
  "dependencies": {
    "ngrok": "^3.4.0",
    "pg": "^8.5.1",
    "pino": "^5.17.0",
    "pino-pretty": "^3.6.1",
    "reflect-metadata": "^0.1.13",
    "telegraf": "^3.38.0",
    "typeorm": "^0.2.29",
    "typeorm-naming-strategies": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^12.19.12",
    "@types/pino": "^5.20.0",
    "dotenv": "^8.2.0",
    "husky": "^1.3.1",
    "nodemon": "^1.18.10",
    "telegram-typings": "^4.0.0-beta",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.7"
  },
  "husky": {
    "pre-push": "npm run check"
  }
}
